<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <queries><package android:name="com.nothing.thirdparty" /></queries>
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:theme="@style/AppTheme" android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules" android:supportsRtl="true">
        <meta-data android:name="NothingKey" android:value="test" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" /><category android:name="android.intent.category.DEFAULT" /></intent-filter>
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <service android:name=".GlyphTileService" android:exported="true" android:label="Glyph North" android:icon="@drawable/tile_compass" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>
        <service android:name=".CompassService" android:exported="true" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Explicit user-started rear Glyph clock and magnetic compass, including accelerometer shake/flip switching while the front screen is off; visible notification with Stop action" />
            <intent-filter><action android:name="com.nothing.glyph.TOY" /></intent-filter>
            <meta-data android:name="com.nothing.glyph.toy.name" android:resource="@string/app_name" />
            <meta-data android:name="com.nothing.glyph.toy.image" android:resource="@drawable/compass_icon" />
            <meta-data android:name="com.nothing.glyph.toy.summary" android:resource="@string/toy_summary" />
            <meta-data android:name="com.nothing.glyph.toy.aod_support" android:value="1" />
            <meta-data android:name="com.nothing.glyph.toy.introduction" android:value="dev.nothingthings.glyphnorth.MainActivity" />
        </service>
    </application>
</manifest>
